DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pachecker
DB_PASSWORD=change-me
DB_NAME=pachecker
DB_CONNECTION_LIMIT=3
DB_SSL_MODE=disabled
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\\n...\\n-----END CERTIFICATE-----"

# Vercel database bridge; URL ends in /rpc and both values are required in production.
DB_BRIDGE_URL=
DB_BRIDGE_TOKEN=

# Optional local access guard. Required on Vercel; deployment fails closed without it.
PACHECKER_ACCESS_USER=
PACHECKER_ACCESS_PASSWORD=

# Server-only original image storage. Vercel Blob is private; local is blocked on Vercel.
PACHECKER_STORAGE_PROVIDER=vercel-blob
PACHECKER_STORAGE_DIR=data/uploads
# Keep production uploads below Vercel's function payload limit, including multipart overhead.
PACHECKER_MAX_UPLOAD_BYTES=4000000
# Use BLOB_READ_WRITE_TOKEN locally; Vercel OIDC can authenticate automatically when BLOB_STORE_ID is set.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# Optional alternative: Cloudflare R2 (`PACHECKER_STORAGE_PROVIDER=r2`).
PACHECKER_R2_ACCOUNT_ID=
PACHECKER_R2_BUCKET=
PACHECKER_R2_ACCESS_KEY_ID=
PACHECKER_R2_SECRET_ACCESS_KEY=
# Optional override. Normally derived from PACHECKER_R2_ACCOUNT_ID.
# PACHECKER_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# Server-only CLIProxyAPI-compatible multimodal endpoint.
# For Vercel production, point this to the separately hosted HTTPS endpoint.
CLIPROXY_API_URL=http://127.0.0.1:8317/v1
CLIPROXY_API_MODEL=MODEL_NAME
CLIPROXY_API_KEY=
CLIPROXY_API_TIMEOUT_MS=60000
